<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset name="general" label="COM_DHARMASITEMAP_CONFIG_GENERAL">
        <field name="sitemap_base_url" type="url" label="COM_DHARMASITEMAP_FIELD_BASE_URL" description="COM_DHARMASITEMAP_FIELD_BASE_URL_DESC" filter="url" />
        <field name="tracking_parameters" type="textarea" rows="3" label="COM_DHARMASITEMAP_FIELD_TRACKING" description="COM_DHARMASITEMAP_FIELD_TRACKING_DESC" default="utm_*, fbclid, gclid, yclid, dclid, msclkid, ref, source" filter="string" />
        <field name="part_size" type="number" label="COM_DHARMASITEMAP_FIELD_PART_SIZE" description="COM_DHARMASITEMAP_FIELD_PART_SIZE_DESC" default="45000" min="1000" max="50000" filter="integer" />
        <field name="respect_noindex" type="radio" label="COM_DHARMASITEMAP_FIELD_RESPECT_NOINDEX" description="COM_DHARMASITEMAP_FIELD_RESPECT_NOINDEX_DESC" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="keep_builds" type="number" label="COM_DHARMASITEMAP_FIELD_KEEP_BUILDS" description="COM_DHARMASITEMAP_FIELD_KEEP_BUILDS_DESC" default="3" min="1" max="20" filter="integer" />
    </fieldset>
    <fieldset name="sources" label="COM_DHARMASITEMAP_CONFIG_SOURCES">
        <field name="include_content" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_CONTENT" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_contacts" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_CONTACTS" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_newsfeeds" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_NEWSFEEDS" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_tags" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_TAGS" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_dharmashop_products" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_DHARMASHOP_PRODUCTS" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_dharmashop_categories" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_DHARMASHOP_CATEGORIES" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_dharmashop_brands" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_DHARMASHOP_BRANDS" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_dharmashop_badges" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_DHARMASHOP_BADGES" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_dharmashop_landings" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_DHARMASHOP_LANDINGS" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="include_menu" type="radio" label="COM_DHARMASITEMAP_FIELD_INCLUDE_MENU" description="COM_DHARMASITEMAP_FIELD_INCLUDE_MENU_DESC" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="skip_empty_categories" type="radio" label="COM_DHARMASITEMAP_FIELD_SKIP_EMPTY" description="COM_DHARMASITEMAP_FIELD_SKIP_EMPTY_DESC" default="1" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
    </fieldset>
    <fieldset name="exclusions" label="COM_DHARMASITEMAP_CONFIG_EXCLUSIONS">
        <field name="exclude_url_patterns" type="textarea" rows="7" label="COM_DHARMASITEMAP_FIELD_EXCLUDE_URLS" description="COM_DHARMASITEMAP_FIELD_EXCLUDE_URLS_DESC" filter="string" />
        <field name="exclude_entities" type="textarea" rows="7" label="COM_DHARMASITEMAP_FIELD_EXCLUDE_ENTITIES" description="COM_DHARMASITEMAP_FIELD_EXCLUDE_ENTITIES_DESC" filter="string" />
    </fieldset>
    <fieldset name="llms" label="COM_DHARMASITEMAP_CONFIG_LLMS">
        <field name="llms_enabled" type="radio" label="COM_DHARMASITEMAP_FIELD_LLMS_ENABLED" description="COM_DHARMASITEMAP_FIELD_LLMS_ENABLED_DESC" default="0" class="btn-group btn-group-yesno"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="llms_title" type="text" label="COM_DHARMASITEMAP_FIELD_LLMS_TITLE" description="COM_DHARMASITEMAP_FIELD_LLMS_TITLE_DESC" filter="string" />
        <field name="llms_summary" type="textarea" rows="3" label="COM_DHARMASITEMAP_FIELD_LLMS_SUMMARY" description="COM_DHARMASITEMAP_FIELD_LLMS_SUMMARY_DESC" filter="string" />
        <field name="llms_details" type="textarea" rows="4" label="COM_DHARMASITEMAP_FIELD_LLMS_DETAILS" description="COM_DHARMASITEMAP_FIELD_LLMS_DETAILS_DESC" filter="string" />
        <field name="llms_rename_sections" type="textarea" rows="4" label="COM_DHARMASITEMAP_FIELD_LLMS_RENAME" description="COM_DHARMASITEMAP_FIELD_LLMS_RENAME_DESC" filter="string" />
        <field name="llms_section_order" type="textarea" rows="4" label="COM_DHARMASITEMAP_FIELD_LLMS_ORDER" description="COM_DHARMASITEMAP_FIELD_LLMS_ORDER_DESC" filter="string" />
        <field name="llms_max_links" type="number" label="COM_DHARMASITEMAP_FIELD_LLMS_MAX" description="COM_DHARMASITEMAP_FIELD_LLMS_MAX_DESC" default="300" min="10" max="2000" filter="integer" />
        <field name="llms_exclude_url_patterns" type="textarea" rows="4" label="COM_DHARMASITEMAP_FIELD_LLMS_EXCLUDE" description="COM_DHARMASITEMAP_FIELD_LLMS_EXCLUDE_DESC" filter="string" />
    </fieldset>
    <fieldset name="permissions" label="COM_DHARMASITEMAP_TAB_PERMISSIONS">
        <field name="rules" type="rules" component="com_dharmasitemap" section="component" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" />
    </fieldset>
</config>
